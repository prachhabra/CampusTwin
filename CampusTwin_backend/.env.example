# Copy this file to .env before running the server.
# .env is git-ignored — never commit real secrets.

PORT=5000

# Local MongoDB (needs MongoDB installed & running locally):
MONGO_URI=mongodb://127.0.0.1:27017/campustwin

# OR MongoDB Atlas (cloud, no local install needed) — get this string from
# Atlas -> Connect -> Drivers, then replace <username>/<password>:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campustwin

JWT_SECRET=campustwin_dev_secret_change_this
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173
